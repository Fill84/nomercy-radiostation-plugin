<Project Sdk="Microsoft.NET.Sdk">

    <!--
        NoMercy MediaServer plugin project.

        Targets net10.0 to match the server's target framework (Directory.Build.props).
        References NoMercy.Plugins.Abstractions for the IPlugin / IMediaSourcePlugin contracts.

        plugin.json is copied next to the output DLL so the resulting bin folder is a
        ready-to-drop plugin directory: copy it into <server>/plugins/ and the
        PluginManager will discover it via plugin.json.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>NoMercy.Plugin.InternetRadio</AssemblyName>
        <RootNamespace>NoMercy.Plugin.InternetRadio</RootNamespace>
        <Version>1.0.0</Version>
        <Authors>NoMercy Community</Authors>
        <Description>Adds a curated list of internet radio stations as a music media source.</Description>
    </PropertyGroup>

    <ItemGroup>
        <!--
            The only required reference: the plugin contracts.
            Version="*" lets the central package manifest pick the version
            compatible with the running server (see Directory.Packages.props).
        -->
        <PackageReference Include="NoMercy.Plugins.Abstractions" Version="10.0.100-nmui" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Ship plugin.json next to the DLL. PluginManager looks for plugin.json
            in each plugin sub-directory of <server>/plugins/.
        -->
        <None Update="plugin.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

  <ItemGroup>
    <None Include="lang\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
