<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" Version="[7.0.0,8.0.0)" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
        <!-- The payload emitter serializes the way the API does, and skips itself
             unless an output folder is named. -->
        <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.7" />
        <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
        <PackageReference Include="xunit" Version="2.*" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Declared here as well as in the plugin, because a floating version does not
            flow through a ProjectReference: the test project has to resolve NoMercy.* for
            itself, and inherited "*" reaches it as ">= 0.0.0" against no source it is
            allowed to search. Same floating version on purpose - pinning one side would
            let the tests compile against a contract the plugin was not built with.
        -->
        <PackageReference Include="NoMercy.Plugins.Abstractions" Version="*" />
        <PackageReference Include="NoMercy.Plugins.Mvc" Version="*" />

        <ProjectReference Include="..\..\src\NoMercy.Plugin.InternetRadio\NoMercy.Plugin.InternetRadio.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\src\NoMercy.Plugin.InternetRadio\plugin.json"
              Link="plugin.json"
              CopyToOutputDirectory="PreserveNewest" />

        <!--
            Linked under lang\ so the layout beside the test binary is the one the server
            sees beside an installed plugin.json. TranslationTests reads them through the
            host's own validator, and a flat copy here would let a test pass against a
            shape no server ever gets.
        -->
        <None Include="..\..\src\NoMercy.Plugin.InternetRadio\lang\*.json"
              Link="lang\%(Filename)%(Extension)"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
